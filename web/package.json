{
  "name": "@taster/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Paste a URL, see which slop rules it hits. Runs rules/detect.js through engine/diagnose.mjs in a server-side Chromium.",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "predev": "node scripts/copy-fixtures.mjs",
    "dev": "next dev --port 3240",
    "prebuild": "node scripts/copy-fixtures.mjs",
    "build": "next build",
    "start": "next start --port 3240",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "self-check": "node scripts/self-check.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "ipaddr.js": "2.5.0",
    "next": "16.4.3",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
