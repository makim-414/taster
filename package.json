{
  "name": "@makim-414/taster",
  "version": "0.2.0",
  "private": true,
  "description": "Find the AI generated look in a frontend and fix it: 88 rules, 85 measured in a real browser, 122 patterns and 144 components to swap in, for agents (MCP, ACP), editors, CI and the browser.",
  "type": "module",
  "license": "MIT",
  "author": "makim-414",
  "homepage": "https://github.com/makim-414/taster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makim-414/taster.git"
  },
  "bugs": "https://github.com/makim-414/taster/issues",
  "keywords": [
    "design",
    "ui",
    "frontend",
    "ai-slop",
    "design-system",
    "mcp",
    "acp",
    "lint",
    "accessibility"
  ],
  "bin": {
    "taster": "packages/engine/taster.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "packages/engine/*.mjs",
    "packages/engine/*.js",
    "packages/engine/package.json",
    "packages/engine/README.md",
    "data/rules/detect.js",
    "data/rules/rules.json",
    "data/rules/RULES.md",
    "data/patterns/",
    "data/taxonomy/",
    "!data/taxonomy/*.test.mjs",
    "!data/taxonomy/fixtures/",
    "packages/registry/registry.json",
    "packages/registry/src/",
    "packages/registry/stage/",
    "packages/registry/previews/",
    "packages/registry/THIRD_PARTY_NOTICES.md",
    "packages/registry/README.md",
    "skills/taster/",
    "commands/",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "test": "node scripts/gates.mjs",
    "build": "node scripts/build-docs.mjs",
    "validate": "node scripts/validate.mjs",
    "check:taxonomy": "node scripts/check-taxonomy.mjs",
    "test:taxonomy": "node --test data/taxonomy/axes.test.mjs",
    "test:detect": "node data/rules/test-detect.mjs",
    "test:registry": "npm --prefix packages/registry run typecheck && node packages/registry/test-render.mjs"
  }
}
